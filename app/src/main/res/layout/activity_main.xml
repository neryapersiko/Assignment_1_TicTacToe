<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- סטטוס -->
    <TextView
        android:id="@+id/statusText"
        android:text="Turn: X"
        android:textSize="24sp"
        android:layout_marginBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- לוח 3x3 -->
    <GridLayout
        android:id="@+id/boardGrid"
        android:rowCount="3"
        android:columnCount="3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- 9 כפתורים עם tag מ-0 עד 8 -->
        <Button android:id="@+id/button0" android:tag="0" android:text=""
            android:layout_width="80dp" android:layout_height="80dp"
            android:onClick="onCellClick"/>
        <Button android:id="@+id/button1" android:tag="1" android:text=""
            android:layout_width="80dp" android:layout_height="80dp"
            android:onClick="onCellClick"/>
        <Button android:id="@+id/button2" android:tag="2" android:text=""
            android:layout_width="80dp" android:layout_height="80dp"
            android:onClick="onCellClick"/>
        <Button android:id="@+id/button3" android:tag="3" android:text=""
            android:layout_width="80dp" android:layout_height="80dp"
            android:onClick="onCellClick"/>

        <Button
            android:id="@+id/button4"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:onClick="onCellClick"
            android:rotationX="-6"
            android:tag="4"
            android:text="" />
        <Button android:id="@+id/button5" android:tag="5" android:text=""
            android:layout_width="80dp" android:layout_height="80dp"
            android:onClick="onCellClick"/>
        <Button android:id="@+id/button6" android:tag="6" android:text=""
            android:layout_width="80dp" android:layout_height="80dp"
            android:onClick="onCellClick"/>
        <Button android:id="@+id/button7" android:tag="7" android:text=""
            android:layout_width="80dp" android:layout_height="80dp"
            android:onClick="onCellClick"/>
        <Button android:id="@+id/button8" android:tag="8" android:text=""
            android:layout_width="80dp" android:layout_height="80dp"
            android:onClick="onCellClick"/>
    </GridLayout>

    <!-- כפתור Play Again -->
    <Button
        android:id="@+id/playAgainButton"
        android:text="Play Again"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>