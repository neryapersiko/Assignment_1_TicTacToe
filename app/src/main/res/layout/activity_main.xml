<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- סטטוס -->
    <TextView
        android:id="@+id/statusText"
        android:text="@string/turn_status"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#333333"
        android:gravity="center"
        tools:text="Turn: X"/>

    <!-- לוח 3x3 -->
    <GridLayout
        android:id="@+id/boardGrid"
        android:rowCount="3"
        android:columnCount="3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:padding="4dp">

        <Button android:id="@+id/button0" android:tag="0" android:text=""
            android:backgroundTint="@android:color/white"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_margin="4dp"
            android:textSize="48sp"
            android:onClick="onCellClick"
            app:cornerRadius="0dp"
            tools:ignore="ContentDescription" />
        <Button android:id="@+id/button1" android:tag="1" android:text=""
            android:backgroundTint="@android:color/white"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_margin="4dp"
            android:textSize="48sp"
            android:onClick="onCellClick"
            app:cornerRadius="0dp"
            tools:ignore="ContentDescription" />
        <Button android:id="@+id/button2" android:tag="2" android:text=""
            android:backgroundTint="@android:color/white"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_margin="4dp"
            android:textSize="48sp"
            android:onClick="onCellClick"
            app:cornerRadius="0dp"
            tools:ignore="ContentDescription" />
        <Button android:id="@+id/button3" android:tag="3" android:text=""
            android:backgroundTint="@android:color/white"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_margin="4dp"
            android:textSize="48sp"
            android:onClick="onCellClick"
            app:cornerRadius="0dp"
            tools:ignore="ContentDescription" />
        <Button android:id="@+id/button4" android:tag="4" android:text=""
            android:backgroundTint="@android:color/white"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_margin="4dp"
            android:textSize="48sp"
            android:onClick="onCellClick"
            app:cornerRadius="0dp"
            tools:ignore="ContentDescription" />
        <Button android:id="@+id/button5" android:tag="5" android:text=""
            android:backgroundTint="@android:color/white"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_margin="4dp"
            android:textSize="48sp"
            android:onClick="onCellClick"
            app:cornerRadius="0dp"
            tools:ignore="ContentDescription" />
        <Button android:id="@+id/button6" android:tag="6" android:text=""
            android:backgroundTint="@android:color/white"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_margin="4dp"
            android:textSize="48sp"
            android:onClick="onCellClick"
            app:cornerRadius="0dp"
            tools:ignore="ContentDescription" />
        <Button android:id="@+id/button7" android:tag="7" android:text=""
            android:backgroundTint="@android:color/white"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_margin="4dp"
            android:textSize="48sp"
            android:onClick="onCellClick"
            app:cornerRadius="0dp"
            tools:ignore="ContentDescription" />
        <Button android:id="@+id/button8" android:tag="8" android:text=""
            android:backgroundTint="@android:color/white"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_margin="4dp"
            android:textSize="48sp"
            android:onClick="onCellClick"
            app:cornerRadius="0dp"
            tools:ignore="ContentDescription" />
    </GridLayout>

    <!-- כפתור Play Again -->
    <Button
        android:id="@+id/playAgainButton"
        android:text="@string/play_again"
        android:visibility="gone"
        android:layout_marginTop="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/black"
        android:textColor="@android:color/white"/>
</LinearLayout>